{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "candidate_areas", "avoid", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "evidence", "sources", "repo_application"],
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string", "enum": ["OURS", "PUBLIC-Sol", "PUBLIC-general", "ANECDOTAL"] },
          "sources": { "type": "array", "items": { "type": "string" } },
          "repo_application": { "type": "string", "description": "how this applies to the repository under study" }
        }
      }
    },
    "candidate_areas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["area", "why_hard_for_sol", "pain_points"],
        "properties": {
          "area": { "type": "string", "description": "subsystem / directories / contract in this repo" },
          "why_hard_for_sol": { "type": "string" },
          "pain_points": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "avoid": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  }
}
